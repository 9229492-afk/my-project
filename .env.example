# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env

# Токен бота. Выдаёт @BotFather в Telegram по команде /newbot
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram ID — на него бот пришлёт заказы.
# Узнать: запусти бота и отправь ему команду /id
# Пока пусто — бот запустится и без этого, чтобы можно было узнать ID.
ADMIN_ID=
